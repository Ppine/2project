# backend (Django) — 저장소 루트의 .env 로 복사해 사용
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# 폰(앱·모바일 웹)에서 PC 서버에 붙을 때 PC 의 LAN IP. 쉼표로 여러 개
DJANGO_ALLOWED_HOSTS=
# 규칙·사전으로 못 푼 반복 결제만 Gemini 로 출처 추론. 비워 두면 LLM 단계를 건너뛴다.
# 무료 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Gemini 응답 대기 한도(ms). 넘으면 LLM 없이 규칙 기반 결과만 보여준다.
# GEMINI_TIMEOUT_MS=20000
